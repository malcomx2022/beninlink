APP_NAME=BeninLink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://beninlink.app
APP_LOCALE=fr
APP_TIMEZONE=Africa/Porto-Novo
TENANCY_CENTRAL_DOMAIN=beninlink.app
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=beninlink
DB_USERNAME=beninlink
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
CURRENCY=XOF
# FedaPay — Mobile Money Bénin (MTN MoMo + Moov Money)
# 'sandbox' pour les tests (aucun argent réel), 'live' en production.
# Toute autre valeur est traitée comme sandbox : une faute de frappe ne peut pas
# faire basculer en production par accident.
FEDAPAY_ENVIRONMENT=live
# Clés du tableau de bord FedaPay. Sandbox et live ont des clés DISTINCTES :
# une clé sandbox en production échoue, et inversement.
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Secret de signature des webhooks (Workbench → Webhooks). Distinct de la clé
# secrète. Sans lui, AUCUN webhook n'est accepté et aucun wallet n'est crédité.
FEDAPAY_WEBHOOK_SECRET=
# Tolérance d'horodatage des webhooks, en secondes (défaut 300). Protège du rejeu.
FEDAPAY_WEBHOOK_TOLERANCE=300
# Délai réseau des appels FedaPay, en secondes (défaut 30).
FEDAPAY_TIMEOUT=30
