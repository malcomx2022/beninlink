APP_NAME=BeninLink
APP_ENV=production

# Généré sur le serveur, JAMAIS recopié d'un autre environnement :
#   php artisan key:generate
# Elle chiffre les sessions et les données `encrypted` en base. La changer sur
# une base existante rend illisible tout ce qu'elle a chiffré.
APP_KEY=

APP_DEBUG=false
APP_URL=https://beninlink.app
APP_LOCALE=fr
APP_TIMEZONE=Africa/Porto-Novo
TENANCY_CENTRAL_DOMAIN=beninlink.app

# ⚠️ LA LIGNE SANS LAQUELLE RIEN NE S'AFFICHE.
# `IsInstalledMiddleware` redirige **chaque requête** vers `/install` tant que
# cette valeur ne vaut pas exactement `yes`. Sans elle, un déploiement réussi
# sert l'installateur We Courier au lieu de l'application — et l'installateur
# propose de recréer la base.
# L'installateur l'écrit lui-même quand on passe par lui ; sur une installation
# déployée par `deploy.sh`, personne ne le fait à sa place.
APP_INSTALLED=yes

# Journal : `daily` fait tourner les fichiers (14 jours par défaut) au lieu de
# laisser `laravel.log` grossir sans fin. `error` en production : `debug`, le
# défaut du socle, écrit chaque requête SQL — volume, et parfois des données
# de clients dans un fichier que l'on finit par envoyer par courriel.
LOG_CHANNEL=daily
LOG_LEVEL=error
# Clé d'API des applications mobiles (constat S3). Le socle We Courier livrait
# une valeur en dur, identique pour toutes les installations et embarquée en
# clair dans les APK. Générer une valeur PROPRE à cette installation :
#   php -r 'echo "blk_".bin2hex(random_bytes(16));'
# ⚠️ Elle voyage dans chaque requête et se retrouve dans le bundle mobile : ce
# n'est pas une authentification. Les données restent protégées par Sanctum.
# Toute rotation impose de republier les applications mobiles.
API_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=beninlink
DB_USERNAME=beninlink
DB_PASSWORD=
# Cache, file d'attente, sessions — SANS Redis (décision D13).
#
# Ce modèle a longtemps déclaré `redis` pour les trois. Aucune installation ne
# le suivait : `RedisTenancyBootstrapper` est commenté dans `config/tenancy.php`
# (« phpredis is needed »), aucun paquet `predis` n'est installé, et le socle
# lui-même — `web/.env.example` — dit `file`, `database`, `file`. Trois lignes
# annonçaient donc une architecture que rien n'implémentait, et qui aurait
# imposé d'installer `php8.3-redis` et un serveur Redis sur le VPS.
#
# Une de ces lignes ne servait même à rien : Laravel 10 lit `CACHE_DRIVER`
# (`config/cache.php`), pas `CACHE_STORE` — nom apparu en Laravel 11. La
# variable était ignorée et le cache retombait sur `file`, silencieusement.
#
# `file` pour le cache, et non `database` : il n'existe aucune migration de
# table `cache` dans ce dépôt. Le cache reste cloisonné par société — c'est
# `CacheTenancyBootstrapper`, actif, qui préfixe les clés.
CACHE_DRIVER=file

# `database` : la file des envois (SMS, push, e-mails) passe par la table
# `jobs`, créée par la migration du 2026-09-05. C'est la décision D13. Le
# worker suit cette variable — il ne nomme aucune connexion (voir
# supervisor/beninlink-worker.conf).
QUEUE_CONNECTION=database

# `file` comme le socle. La table `sessions` existe et `database` marcherait
# aussi ; changer ce pilote déconnecte tout le monde, donc on ne le change pas
# sans raison.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# `true` : le cookie de session ne part que sur HTTPS. Le site est en HTTPS
# (voir nginx/beninlink.conf) ; sans cette ligne, le cookie voyagerait aussi en
# clair sur une requête HTTP qui aurait échappé à la redirection.
SESSION_SECURE_COOKIE=true

# SESSION_DOMAIN : à laisser VIDE, délibérément.
# Le cookie est alors limité à l'hôte exact qui l'a posé — donc au sous-domaine
# d'UNE société. Y mettre `.beninlink.app` partagerait un même cookie de session
# entre tous les transporteurs du multi-tenant. Ce n'est pas un réglage de
# confort : c'est la frontière entre deux clients.
SESSION_DOMAIN=

CURRENCY=XOF
# FedaPay — Mobile Money Bénin (MTN MoMo + Moov Money)
# 'sandbox' pour les tests (aucun argent réel), 'live' en production.
# Toute autre valeur est traitée comme sandbox : une faute de frappe ne peut pas
# faire basculer en production par accident.
FEDAPAY_ENVIRONMENT=live
# Clés du tableau de bord FedaPay. Sandbox et live ont des clés DISTINCTES :
# une clé sandbox en production échoue, et inversement.
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Secret de signature des webhooks (Workbench → Webhooks). Distinct de la clé
# secrète. Sans lui, AUCUN webhook n'est accepté et aucun wallet n'est crédité.
FEDAPAY_WEBHOOK_SECRET=
# Tolérance d'horodatage des webhooks, en secondes (défaut 300). Protège du rejeu.
FEDAPAY_WEBHOOK_TOLERANCE=300
# Délai réseau des appels FedaPay, en secondes (défaut 30).
FEDAPAY_TIMEOUT=30

# --- Courriels ---------------------------------------------------------------
# L'application en envoie : inscription d'un marchand, inscription d'une société,
# formulaire de contact, relevés. Depuis D13 ils partent par la file — un SMTP
# injoignable ne bloque donc plus la requête, mais il fait échouer le job, et
# l'échec ne se voit que dans la table `failed_jobs`.
#
# Sans ces lignes, Laravel vise `smtp.mailgun.org` et signe `hello@example.com`
# (valeurs par défaut de `config/mail.php`) : rien ne part, et rien ne le dit.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# L'adresse doit appartenir au domaine authentifié (SPF/DKIM), sinon les
# messages partent en indésirables — ou sont refusés.
MAIL_FROM_ADDRESS=no-reply@beninlink.app
MAIL_FROM_NAME=BeninLink

# --- Notifications poussées (D11) --------------------------------------------
# Rien à renseigner. Le transport est Expo (`config/push.php`), et c'est Expo qui
# porte les identifiants FCM et APNs : le backend n'a AUCUN secret à stocker —
# décisif en multi-tenant, où une clé par société serait à saisir et à faire
# tourner. `PUSH_EXPO_ACCESS_TOKEN` ne devient nécessaire que si le compte Expo
# active « enhanced security for push notifications ».
#
# `PUSH_DRIVER=null` coupe les envois sans rien casser : le fil en base continue
# d'être écrit. C'est la valeur d'une installation sans app mobile publiée.
# PUSH_DRIVER=expo

# --- SMS : rien ici non plus --------------------------------------------------
# Les identifiants d'opérateur (Twilio, Vonage…) vivent en base, par société,
# dans les réglages du back-office — c'est ce qui permet à chaque transporteur
# d'avoir son propre compte et sa propre facture. Les mettre ici les rendrait
# communs à tous.

# --- Paiement en ligne : coupé (D10) -----------------------------------------
# PayPal, Razorpay, Stripe et Paytm ne vérifiaient rien auprès du fournisseur :
# un identifiant de transaction inventé éteignait la dette d'un marchand. Le
# module est retiré. Laisser ces variables ABSENTES ; les renseigner ne
# réactive rien, mais laisse croire le contraire.
