{
  "expo": {
    "name": "BeninLink Marchand",
    "slug": "beninlink-marchand",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "beninlink",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "locales": {
      "fr": "./src/i18n/expo-fr.json"
    },
    "android": {
      "package": "app.beninlink.marchand",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#12503A"
      }
    },
    "ios": {
      "bundleIdentifier": "app.beninlink.marchand",
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#12503A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12503A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "projectId": "dec3eeea-1ea8-4e8d-8eb0-09d2a8603d5c",
    "owner": "ulrichseglas-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dec3eeea-1ea8-4e8d-8eb0-09d2a8603d5c"
      }
    }
  }
}
