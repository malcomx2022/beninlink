# Copier vers .env (jamais versionné) et renseigner selon l'environnement.
#
# ⚠️ Les variables EXPO_PUBLIC_* sont embarquées EN CLAIR dans le bundle :
# n'y mettre aucun secret réel. Les clés FedaPay, notamment, restent
# exclusivement côté web/ — l'app n'ouvre que la payment_url renvoyée.

# Base de l'API, préfixe de version inclus, sans / final.
# Local (WAMP)   : http://10.0.2.2/beninlink/web/public/api/v10   (émulateur Android)
#                  http://localhost/beninlink/web/public/api/v10  (web / iOS simulateur)
# Production     : https://beninlink.app/api/v10
EXPO_PUBLIC_API_URL=http://10.0.2.2/beninlink/web/public/api/v10

# En-tête `apiKey` exigé par le backend sur toutes les routes.
# Valeur attendue = config('rxcourier.api_key') côté web/.
EXPO_PUBLIC_API_KEY=
