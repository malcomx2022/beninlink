{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "recette": {
      "distribution": "internal",
      "channel": "recette",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://recette.beninlink.app/api/v10"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beninlink.app/api/v10"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
