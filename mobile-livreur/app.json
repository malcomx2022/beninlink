{
  "expo": {
    "name": "BeninLink Livreur",
    "slug": "beninlink-livreur",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "beninlink-livreur",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "locales": {
      "fr": "./src/i18n/expo-fr.json"
    },
    "android": {
      "package": "app.beninlink.livreur",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#12503A"
      }
    },
    "ios": {
      "bundleIdentifier": "app.beninlink.livreur",
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BeninLink Livreur transmet votre position au transporteur pendant vos courses."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "BeninLink Livreur utilise l'appareil photo pour la preuve de livraison.",
          "photosPermission": "BeninLink Livreur accède à vos photos pour joindre une preuve de livraison."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12503A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12503A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
